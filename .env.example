# Copy this file to .env and fill in your keys:
#   cp .env.example .env        (macOS / Linux)
#   Copy-Item .env.example .env (Windows PowerShell)

# --- Required for the default fully enabled OpenAI + web-search setup (see the
# local provider block at the bottom, where neither key is used) ---

# OpenAI: used by OpenAIEmbeddings (ingestion + retrieval) for every cloud
# profile, and by GPT chat targets selected by the model profile below.
OPENAI_API_KEY=sk-your-openai-key

# Together AI: required only when MODEL_OPTIMIZATION_PROFILE selects
# flash_luna. It serves the profile's Together-hosted DeepSeek Flash chat
# targets, is never used for embeddings, and is not an OpenAI fallback.
# TOGETHER_API_KEY=your-together-key

# Tavily: required only when the effective run can use web search. It is not
# needed under PRIVACY_MODE=true, local-provider mode, or an unoverridden
# WEB_SEARCH_ENABLED=false default.
TAVILY_API_KEY=tvly-your-tavily-key

# --- Optional: deployment modes (recommended spellings) ---

# Privacy mode: an absolute lock. When true, no question is ever sent to an
# external web search service (Tavily) and no LangSmith trace is exported.
# Stronger than WEB_SEARCH_ENABLED=false below: that one is a DEFAULT which a
# per-run option may override, while PRIVACY_MODE cannot be overridden per run.
# Scope limit: this stops web search and trace export, not the OpenAI calls —
# use FULLY_LOCAL_MODE below to remove third-party model calls too.
# Accepts true/1/yes/on or false/0/no/off; anything else fails at startup.
# false or unset asserts nothing, leaving WEB_SEARCH_ENABLED and per-run
# options in control. Default: false.
# PRIVACY_MODE=false

# Fully local mode: route every LLM and embedding call to the local endpoint
# (see OLLAMA_BASE_URL below) and implicitly apply the same absolute privacy
# lock. Equivalent to LLM_PROVIDER=ollama, which keeps working on its own.
# false or unset asserts nothing — LLM_PROVIDER stays in control, so
# FULLY_LOCAL_MODE=false together with LLM_PROVIDER=ollama still runs locally.
# The only contradiction is FULLY_LOCAL_MODE=true with LLM_PROVIDER=openai,
# which fails at startup naming both. Default: false.
# FULLY_LOCAL_MODE=false

# --- Optional ---

# Privacy / enterprise mode (legacy spelling of PRIVACY_MODE above, kept fully
# supported): set to false to disable ALL external web search AND LangSmith
# trace export. Unlike PRIVACY_MODE, this is a DEFAULT — an explicit per-run
# AnswerOptions(web_search_enabled=True) still wins over it, which is how the
# eval harness runs privacy rows and web rows in the same process.
# When this default resolves to false for a run, the question is not sent to
# Tavily; the assistant answers only from the local vector store and returns
# its deterministic insufficient-context response when the knowledge base
# cannot answer. No LangSmith trace is exported for that run either. An
# explicit per-run true option can override this environment default; use
# PRIVACY_MODE=true or local-provider mode when the setting must be absolute.
# Scope limit: this stops web search and trace export, not cloud model calls.
# The question and retrieved chunks still reach the cloud chat provider(s)
# selected by MODEL_OPTIMIZATION_PROFILE for retrieval/document grading,
# generation, grounding grading, and answer-usefulness grading. Cloud
# retrieval also sends the query to OpenAI for embedding. Routing is not among
# these calls: the web-search-off path skips the router LLM entirely (and the
# router only ever sees the question, never retrieved chunks).
# Default (unset or any other value): true.
# WEB_SEARCH_ENABLED=true

# Web-fallback policy: when web search is allowed, decides WHEN document
# grading falls back to the web (distinct from the resolved web-search gate;
# this policy has no effect when the effective run has web search disabled):
#   conservative (default) - generate from the remaining relevant local
#                            documents; web search only when none remain.
#   aggressive             - legacy CRAG behavior: any irrelevant retrieved
#                            document triggers web fallback before generation.
#   disabled               - local retrieval paths never escalate to the web
#                            (including the post-generation not-useful retry);
#                            router-chosen web searches still work.
# Invalid values fall back to conservative.
# WEB_FALLBACK_POLICY=conservative

# LangSmith tracing (recommended for debugging the self-correction loops).
# A LangSmith trace carries full prompts and the page_content of retrieved
# internal documents to a third-party service. A run with effective
# web_search_enabled=false suppresses export entirely and ignores these
# settings. WEB_SEARCH_ENABLED=false supplies an overridable default;
# PRIVACY_MODE=true and local-provider mode force it. To debug a private run,
# use the metadata-only engine trace (AnswerOptions.trace_path) instead.
# The legacy LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY / LANGCHAIN_PROJECT
# names are still honored by the SDK; prefer the LANGSMITH_* names below.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-your-langsmith-key
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=agentic-rag-assistant

# Per-run cost/latency budgets. Defaults (30 / 5 / 15) sit above the worst
# case the retry loop can produce, so they only bind if you tighten them.
# Invalid or non-positive values fall back to the defaults.
# MAX_LLM_CALLS_PER_RUN=30
# MAX_WEB_SEARCHES_PER_RUN=5
# MAX_WEB_RESULTS_TO_GRADE=15

# Per-request timeout (seconds) for a single LLM call. Bounds wall-clock time
# on one chat-model request so a hung dependency cannot stall a run; a timeout
# is mapped to the appropriate *_error stop_reason by existing handlers.
# Invalid or non-positive values fall back to the default.
# Note for LLM_PROVIDER=ollama: 60s is likely too tight for local inference,
# especially on the first call while the model cold-loads into memory.
# LLM_REQUEST_TIMEOUT_SECONDS=60

# Static cloud chat-model allocation. This is process-level configuration,
# not request routing; restart the process after changing it. Every cloud
# profile still uses the existing OpenAI embedding/index deployment mode.
#   legacy     - gpt-5-mini for all six tasks (default/legacy baseline)
#   luna_all   - GPT-5.6 Luna for all six tasks
#   flash_luna - Together Flash for question routing, retrieval grading, and
#                hallucination grading; GPT-5.6 Luna for answer grading,
#                generation, and query rewriting
# Privacy mode forces the effective profile to legacy. Local mode overrides
# every cloud profile and requires neither cloud key.
# MODEL_OPTIMIZATION_PROFILE=legacy

# --- Local provider mode (EXPERIMENTAL) ---

# Selects the cloud or local deployment, embedding provider, and provider-scoped
# index. This is process-level, not a per-run option: the retriever is cached
# per process and bound to one embedding space. In cloud mode,
# MODEL_OPTIMIZATION_PROFILE determines the chat task/provider allocation.
#   openai (default) - OpenAIEmbeddings plus the selected cloud chat profile.
#   ollama           - every chat and embedding call goes to the endpoint
#                      below. No data is sent to OpenAI, Together, Tavily, or
#                      LangSmith,
#                      and no failure path falls back to them; web search is
#                      forced off for every run and a per-run option cannot
#                      re-enable it.
# The boundary is "no third-party egress", not "nothing leaves the machine":
# OLLAMA_BASE_URL below is itself the trust boundary and may point at your own
# private infrastructure rather than this host.
# Unlike WEB_FALLBACK_POLICY, an INVALID value here fails loudly instead of
# falling back — silently degrading a typo like "ollma" to openai would ship
# your questions and retrieved chunks to a third party.
# Switching providers needs no re-ingestion once both indexes exist; a changed
# embedding model does (the index fingerprint no longer matches).
# LLM_PROVIDER=openai

# Chat model used when LLM_PROVIDER=ollama. Must be installed on the endpoint
# (`ollama pull <model>`); startup fails with the model name if it is not.
# Quality is entirely the model's — point this at a stronger locally hosted
# model for real use.
# LOCAL_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Embedding model used when LLM_PROVIDER=ollama. Changing it invalidates the
# local index: re-run `uv run python ingestion.py` afterwards.
# LOCAL_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Ollama-compatible endpoint serving both models above.
# OLLAMA_BASE_URL=http://localhost:11434
